# Copy to .env.local and fill in to run against a real backend. Without these the app runs on
# in-memory demo data. All three are public values: the anon key is safe to ship because
# row-level security decides what each signed-in user can read and write.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_POWERSYNC_URL=https://your-instance.powersync.journeyapps.com
