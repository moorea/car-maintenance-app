{
  "expo": {
    "name": "Car Maintenance",
    "slug": "car-maintenance-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.moorea.carmaintenance"
    },
    "android": {},
    "plugins": [
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos of receipts, documents and shop quotes for your car.",
          "cameraPermission": "Photograph receipts, documents and shop quotes for your car.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
